{
  "family": "extract",
  "out_dir": "runs/extract/sweep-24scenes-selfsup",
  "base": {
    "cell": 0.01,
    "steps": 30000,
    "seed": 2,
    "lr_final": 0.005,
    "hid": 64,
    "tau": 0.01
  },
  "grid": {
    "seed": [
      2,
      3,
      5
    ]
  },
  "replicate": "seed",
  "producer": {
    "bin": "parts-3d",
    "argv": [
      "occ",
      "--root",
      "E:/trit-data/s1/renders_v6",
      "--scenes",
      "E:/trit-data/s1/scenes_v6",
      "--train",
      "56,57,58,59,60,61,62,63,64,65,66,67,68,69,70,71,72,73,74,75,76,77,78,79",
      "--eval",
      "84,85,86,87,88,89,90,91",
      "--selfsup",
      "--tau",
      "{tau}",
      "--cell",
      "{cell}",
      "--lr-final",
      "{lr_final}",
      "--hid",
      "{hid}",
      "--steps",
      "{steps}",
      "--seed",
      "{seed}",
      "--save-model",
      "{model}",
      "--run-manifest",
      "{model}.manifest.json"
    ]
  },
  "verifier": {
    "bin": "parts-extract-verify",
    "argv": [
      "--model",
      "{model}"
    ]
  },
  "model": "{out}/{tag}.occ1",
  "jobs": 1,
  "promote": {
    "metric": "iou_mean",
    "min": 0.5,
    "all_closed": true
  },
  "catalogue": true
}
