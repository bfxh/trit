{
  "family": "extract",
  "out_dir": "runs/extract/sweep-selfsup",
  "base": {"cell": 0.01, "steps": 5000, "tau": 0.01},
  "grid": {"tau": [0.01, 0.02]},
  "producer": {
    "bin": "parts-3d",
    "argv": [
      "occ",
      "--root", "E:/trit-data/s1/renders_v6",
      "--scenes", "E:/trit-data/s1/scenes_v6",
      "--train", "80,81,82,83",
      "--eval", "84,85,86,87,88,89,90,91",
      "--cell", "{cell}",
      "--steps", "{steps}",
      "--selfsup",
      "--tau", "{tau}",
      "--save-model", "{model}",
      "--run-manifest", "{model}.manifest.json"
    ]
  },
  "verifier": {"bin": "parts-extract-verify", "argv": ["--model", "{model}"]},
  "model": "{out}/{tag}.occ1",
  "jobs": 1,
  "promote": {"metric": "iou_mean", "min": 0.5, "all_closed": true},
  "catalogue": true
}
