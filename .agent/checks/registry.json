      "kind": "forbid",
      "covers": [
        "L56"
      ],
      "scope": [
        "crates/trit-redteam/src/rail/*.rs",
        "crates/trit-redteam/src/sidechannel/*.rs"
      ],
      "since": "2026-11-19",
      "tier": "fast",
      "added": "2026-11-19T22:37:35+08:00",
      "pattern": "unwrap_or_else\\(\\|\\|\\s*panic!|assert_eq!\\(self\\.peek|expect\\(\"assign 缺 =\"\\)|env\\[\"y_p\"\\]",
