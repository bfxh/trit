__pycache__/

# 本地智能体状态（#121/#122 曾误提交，见 CHG-AJ）
.yanagent/

# 智能体记忆与任务日志：属本机状态，不进公开树（privacy_scan 的 task-doc 同一口径）
.agent/memory/

# 交互信号台账（tools/signal.py）：分诊原文留在本机，研究语料走 export 出口
.agent/signals.jsonl

# 快照底座的本地产物（scripts/snapshot.py）：对象库与清单不进版本库
.trit/

# 离线自足（scripts/vendor.py）：vendor 目录与配置备份不进版本库
/vendor/
.cargo/config.toml.tritbak

# 本机构建产物落盘策略（scripts/wt_target.py 生成；docs/BUILD-PERF.md §5）
.cargo/config.toml

# 本地评测产物（scripts/regress_holdout.sh 等）
/runs/

# 变异门单实例锁（运行时目录，不入库）
scripts/.mutation-check.lock/
*.mutant-tmp

# 快照/回收站底座（tools/journal.py、tools/trash.py 的默认 store）：本机状态，
# 不进公开树；trash.py 的 put 在站点未被 ignore 时会 fail-closed 拒绝
.journal/

# cognition/ 训练层的交互语料（cognition/collect.py 的投影产物）：私有，不出克隆；
# 公开知识（knowledge/）才入库。搬去模型仓库后由 cognition/.gitignore 接管
cognition/corpus/
